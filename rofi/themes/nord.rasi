/* =========================
   Gruvbox Compact Rofi
   ========================= */

* {
    bg:         #1d2021ee;
    bg-alt:     #282828ee;

    fg:         #ebdbb2;
    fg-alt:     #a89984;

    border:     #504945;

    selected:   #d79921;
    active:     #b8bb26;
    urgent:     #fb4934;

    transparent: rgba(0,0,0,0);

    font: "JetBrainsMono Nerd Font 11";
}

/* =========================
   Window
   ========================= */

window {
    transparency: "screenshot";

    location: center;
    anchor: center;

    width: 32%;

    border: 2px;
    border-radius: 16px;
    border-color: @border;

    background-color: @bg;
}

/* =========================
   Main
   ========================= */

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

/* =========================
   Search bar
   ========================= */

inputbar {
    padding: 14px;
    spacing: 10px;

    border: 0px 0px 2px 0px;
    border-color: @border;

    background-color: @bg-alt;
}

/* =========================
   Prompt / Search
   ========================= */

prompt {
    enabled: true;

    background-color: transparent;
    text-color: @selected;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-alt;

    background-color: transparent;
    text-color: @fg;
}

/* remove blocos brancos */
textbox-prompt-colon {
    expand: false;
    str: "";

    background-color: transparent;
}

textbox {
    background-color: transparent;
    text-color: @fg;
}

/* remove indicador branco */
case-indicator {
    background-color: transparent;
    text-color: @fg-alt;
}

/* força transparência em tudo */
prompt,
entry,
case-indicator,
textbox,
textbox-prompt-colon {
    background-color: transparent;
}

/* =========================
   Apps
   ========================= */

listview {
    lines: 8;
    columns: 1;

    padding: 10px;
    spacing: 6px;

    background-color: transparent;

    cycle: true;
    dynamic: true;
}

/* =========================
   Items
   ========================= */

element {
    padding: 12px;

    border-radius: 10px;

    background-color: transparent;
    text-color: @fg;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: #1d2021;
}

/* =========================
   Icon
   ========================= */

element-icon {
    size: 20px;

    background-color: transparent;
}

/* =========================
   Text
   ========================= */

element-text {
    background-color: transparent;

    text-color: inherit;

    vertical-align: 0.5;
}
